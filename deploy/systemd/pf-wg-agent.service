# ParallelF WireGuard gateway agent: keeps the kernel WireGuard interface
# and the nftables table inet parallelf_vpn converged to what pf-vpnd
# decides (enrolled devices, activations, policies).
#
# Installed by `make wg-agent-install`. Settings live in
# /etc/parallelf/wg-agent.env (see scripts/dev/wg-agent-install.sh).
[Unit]
Description=ParallelF WireGuard gateway agent
Documentation=https://github.com/commonvtake/ParallelF/blob/main/docs/vpn.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/parallelf/wg-agent.env
ExecStart=/usr/local/bin/pf-wg-agent
Restart=always
RestartSec=3
# Stopping the agent leaves the interface and firewall in place: enrolled
# devices keep their tunnels, and activations still end on time because
# their expiry is a kernel timeout.
KillMode=process
TimeoutStopSec=15

NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/parallelf
PrivateTmp=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
