# ParallelF local development environment.
#
# `make init` copies this file to .env and replaces every `generate-me` value
# with a random secret. .env is ignored by git; never commit real values.
# Values must not contain spaces, quotes or URL-reserved characters
# (they are used inside connection URLs).

# --- PostgreSQL -------------------------------------------------------------
# Superuser, used only by the container itself and for administration.
POSTGRES_PASSWORD=generate-me
# Owner of schema "core": runs migrations, nothing else.
PF_CORE_OWNER_DB_PASSWORD=generate-me
# Runtime role of pf-core: data access only, no schema changes.
PF_CORE_DB_PASSWORD=generate-me
# Host port PostgreSQL is published on (127.0.0.1 only).
PF_POSTGRES_HOST_PORT=5432

# --- Keycloak (OpenID Connect provider) -------------------------------------
# Admin console: http://localhost:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=generate-me
# Secret of the dashboard's confidential client (parallelf-dashboard).
PF_OIDC_CLIENT_SECRET=generate-me
# Passwords of the two development users in the local realm.
#   owner   role "owner"   full access
#   viewer  role "viewer"  read-only
PF_DEV_OWNER_PASSWORD=generate-me
PF_DEV_VIEWER_PASSWORD=generate-me

# --- Services ---------------------------------------------------------------
# debug, info, warn or error
PF_LOG_LEVEL=info
# Version label built into the images and reported by health endpoints.
PF_VERSION=dev
